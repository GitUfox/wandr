# ──────────────────────────────────────────────────────────────────────────────
# Wandr — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env.local
# 2. Add your key:     get it at https://console.anthropic.com
# 3. Never commit .env.local to git
#
# This key is read by server.js (the proxy) only — it is NOT bundled into
# the browser. The browser calls /api/anthropic; the proxy attaches the key
# server-side before forwarding to Anthropic.
#
# To run: npm run dev:all   (starts proxy on :3001 + Vite on :5173)
# ──────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-your-key-here
