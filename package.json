{
  "name": "wandr",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "server": "node server.js",
    "dev:all": "concurrently -n vite,proxy -c cyan,yellow \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.7"
  }
}
