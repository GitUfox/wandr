# Supply-chain guard: never run a package's install scripts (preinstall /
# install / postinstall). That hook is how the 2025–26 npm worms execute on
# install. Explicit scripts still run: npm test, npm run build, npm run dev.
# Only esbuild and fsevents (both dev tools) ship install scripts, and the
# build and tests pass without them.
ignore-scripts=true
